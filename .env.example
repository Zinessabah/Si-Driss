# ==============================================================================
# SI DRISS - CONFIGURATION UNIVERSELLE (LOCAL & CLOUD)
# ==============================================================================

# Port d'écoute du serveur (par défaut: 3000)
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# CHOIX DU FOURNISSEUR IA PAR DÉFAUT (OPTIONNEL)
# Valeurs possibles : gemini | groq | openai | anthropic | deepseek | mistral | openrouter | custom
# Note : Si vous ne configurez aucune clé ici, l'application demandera à chaque élève
# de renseigner sa propre clé dans l'interface (stockée de manière sécurisée dans son navigateur).
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# CLÉS D'API PAR FOURNISSEUR (Renseignez celle(s) que vous souhaitez activer)
# ------------------------------------------------------------------------------

# 1. Google Gemini (Recommandé, gratuit sur aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

# 2. Groq Cloud (Ultra rapide ~300 tokens/sec, gratuit sur console.groq.com)
GROQ_API_KEY=""

# 3. OpenAI (GPT-4o, GPT-4o-mini sur platform.openai.com)
OPENAI_API_KEY=""

# 4. Anthropic Claude (Claude 3.5 Sonnet / Haiku sur console.anthropic.com)
ANTHROPIC_API_KEY=""

# 5. DeepSeek (DeepSeek V3 / R1 sur platform.deepseek.com)
DEEPSEEK_API_KEY=""

# 6. Mistral AI (Mistral Small / Large sur console.mistral.ai)
MISTRAL_API_KEY=""

# 7. OpenRouter (Accès à 100+ modèles sur openrouter.ai)
OPENROUTER_API_KEY=""

# 8. Ollama / Modèle Local / Endpoint Personnalisé (100% Hors-ligne & gratuit !)
# Si Ollama tourne sur la même machine : http://localhost:11434/v1
# Si dans un conteneur Docker : http://host.docker.internal:11434/v1
OLLAMA_BASE_URL="http://localhost:11434/v1"

# ------------------------------------------------------------------------------
# SÉCURITÉ SERVEUR (recommandé dès que l'app est accessible à d'autres personnes)
# ------------------------------------------------------------------------------
# Mot de passe de classe : si renseigné, toutes les routes /api/* exigent l'en-tête
# x-access-token correspondant. Les élèves ouvrent l'URL avec ?token=VOTRE_MOT_DE_PASSE
# (il est mémorisé dans leur navigateur).
SI_DRISS_ACCESS_TOKEN=""

# Jeton administrateur : requis pour téléverser/supprimer des documents dans
# /docs/programme. Ouvrez l'URL avec ?admin=VOTRE_JETON pour l'enregistrer.
# ⚠️ En production (NODE_ENV=production) sans ADMIN_TOKEN, l'upload/suppression
# de documents est désactivé par sécurité.
ADMIN_TOKEN=""

# ------------------------------------------------------------------------------
# URL PUBLIQUE DE L'APPLICATION (Optionnel, injecté automatiquement en Cloud)
# ------------------------------------------------------------------------------
APP_URL=""
